  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch"
  },
  "dependencies": {
    "bootstrap": "6.0.0-alpha.1"
  },
  "devDependencies": {
    "postcss": "8.5.30",
    "postcss-prefix-custom-properties": "0.1.0",
    "sass": "1.105.2"
  }
}
